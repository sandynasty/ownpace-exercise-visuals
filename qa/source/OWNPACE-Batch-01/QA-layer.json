    "anatomy-and-muscle-map": ["pose plausible", "orange primary only", "blue secondary only"],
    "continuity": ["camera stable", "scale stable", "background stable", "identity stable"],
    "branding": ["official SVG overlay", "112px width", "16px margins", "35 percent opacity"]
  },
  "batch01_review": {
    "passed": ["cycling", "stationary-bike", "treadmill-walk", "brisk-walk", "light-jog", "march-in-place"],
    "passed_with_caution": ["rowing-machine"],
    "regenerated_and_passed": ["incline-treadmill-walk", "elliptical", "arm-circles"],
    "rejected_remaining": []
  }
}
