{
  "version": "1.0",
  "gates": [
    "technical-output",
    "exercise-identity",
    "equipment-mechanics",
    "pose-phase-accuracy",
    "anatomy-and-muscle-map",
    "continuity",
    "branding"
  ],
  "rejection_is_blocking": true,
  "rules": {
    "technical-output": ["three PNGs", "512x512", "sRGB", "exact filenames"],
